{
  "name": "trading-facrory",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-first Indian market trading intelligence workspace",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check angel-feed.js && node --check public/app.js",
    "harness": "node harness/src/run.js",
    "harness:once": "node harness/src/run.js --once",
    "harness:daily": "node harness/src/run.js --once --dry",
    "harness:selfcheck": "node harness/src/selfcheck.js",
    "harness:schema": "node harness/scripts/apply-schema.js",
    "harness:test": "node --test \"harness/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "ws": "8.22.0"
  }
}
