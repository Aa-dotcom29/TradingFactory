{
  "name": "trading-facrory",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-first Indian market trading intelligence workspace",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check angel-feed.js && node --check public/app.js",
    "harness": "node harness/src/run.js",
    "harness:once": "node harness/src/run.js --once",
    "harness:daily": "node harness/src/run.js --once --dry",
    "harness:selfcheck": "node harness/src/selfcheck.js",
    "harness:schema": "node harness/scripts/apply-schema.js",
    "harness:config": "node harness/scripts/approve-config.js",
    "harness:test": "node --test \"harness/test/*.test.js\"",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "web:test": "npm --prefix web test",
    "web:user": "npm --prefix web run create-user",
    "dev:db": "npm --prefix web run dev-db",
    "test:all": "npm run harness:test && npm run web:test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "ws": "8.22.0"
  }
}
