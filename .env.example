# --- Existing dashboard app ---
PORT=4173
SESSION_SECRET=replace-with-a-long-random-value
APP_PASSWORD=paper
# Optional PostgreSQL/Supabase session-pooler or direct connection string.
# Apply schema.sql to the database before setting this value.
DATABASE_URL=
CRON_SECRET=
SCHEDULER_ENABLED=true
MONITOR_INTERVAL_MS=60000
SCAN_INTERVAL_MS=300000
# Angel One SmartAPI read-only market feed. Copy these into .env (never into chat).
ANGEL_CLIENT_ID=
ANGEL_API_KEY=
# Angel One login PIN/password, stored server-side only.
ANGEL_PASSWORD=
# Base32 TOTP secret from the authenticator setup (not a current six-digit code).
ANGEL_TOTP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Market intelligence harness (Slice 0 through Slice 5) ---
# Role: all | w0 (ingest) | w1 (news) | w2 (flow) | w3 (bias) | w4 (signals)
#       | w5 (risk gate) | w6 (publisher) | w7 (evaluator) | w8 (supervisor)
#       | w9 (live tape + order book)
HARNESS_ROLE=all
HARNESS_WORKER_NAME=
HARNESS_DRY_RUN=false
# Set true to exit after one cycle (useful for cron / manual runs)
HARNESS_ONCE=false
HARNESS_LOG_LEVEL=info
HARNESS_DB_POOL=5
DATABASE_SSL=false

# Poll cadence (ms). Market needs low latency for momentum; news can be slower.
HARNESS_MARKET_INTERVAL_MS=10000
HARNESS_FLOW_INTERVAL_MS=60000
HARNESS_NEWS_INTERVAL_MS=300000
# How often W1/W2 drain the queue into scored news and flow features.
HARNESS_SCORE_INTERVAL_MS=15000
HARNESS_HEARTBEAT_INTERVAL_MS=30000

# Data sources
HARNESS_NSE_ENABLED=true
HARNESS_NSE_TIMEOUT_MS=15000
HARNESS_NSE_MIN_INTERVAL_MS=1200
ANGEL_TIMEOUT_MS=15000
ANGEL_MAX_PER_SECOND=2
# The instrument master is about 35 MB. A slow link needs more than the quote timeout,
# and the local cache avoids re-downloading it on every worker restart.
ANGEL_SCRIP_MASTER_TIMEOUT_MS=120000
ANGEL_SCRIP_MASTER_CACHE_HOURS=12

# Slice 10: live tape and order book. W9 keeps a bounded token set (the universe plus
# open option plans), stores trade prints for footprint panels, and stores broker depth
# snapshots. F&O depth is five levels; NSE cash can stream twenty. This is not the
# exchange's full anonymous order book, and the footprint side is tape-derived.
HARNESS_TAPE_ENABLED=true
HARNESS_TAPE_DEPTH_TOKENS=50
HARNESS_TAPE_SNAPSHOT_MS=1000
HARNESS_TAPE_REFRESH_MS=60000
HARNESS_TAPE_RECONNECT_MS=5000
HARNESS_TAPE_RETENTION_DAYS=7

# Evaluator: an option plan whose premium series never arrives cannot be judged against spot.
# After this grace window it settles as NO_PRICE_SOURCE instead of staying "open" for the whole
# holding period. Eight hours means a morning signal settles after the same session's close.
HARNESS_UNPRICED_GRACE_HOURS=8

HARNESS_RSS_FEEDS=
HARNESS_RSS_TIMEOUT_MS=15000
HARNESS_RSS_MAX_ITEMS=40

# Yahoo Finance fallback quotes (Slice 5.5). Used only when Angel One is not
# configured, so the bias meter's `price` component still has an input. Rows are
# tagged `yahoo-delayed` because Yahoo's NSE quotes lag the exchange (~15 min).
# Provenance is recorded per row; a delayed read is never presented as live.
HARNESS_YAHOO_ENABLED=true
HARNESS_YAHOO_API_ROOT=https://query1.finance.yahoo.com
HARNESS_YAHOO_RANGE=1d
HARNESS_YAHOO_INTERVAL=1d
HARNESS_YAHOO_TIMEOUT_MS=15000
HARNESS_YAHOO_SPACING_MS=400

# Universe (comma separated). Indices are matched against the Angel One instrument master.
HARNESS_INDEX_UNIVERSE=NIFTY 50,BANK NIFTY,MIDCAP NIFTY
HARNESS_EQUITY_UNIVERSE=RELIANCE,TCS,HDFCBANK

# Signal history retention floor (days). Must stay >= 90 for backtesting.
HARNESS_RETENTION_DAYS=90

# --- Delivery (Slice 5) ---
# shadow (default) composes and records the exact message but sends nothing.
# live calls the Telegram Bot API. Flip per horizon once you trust the signals.
PUBLISH_MODE=shadow
# Per-horizon override, so publishing can be enabled one horizon at a time, Intraday last:
#   PUBLISH_MODE_SWING=live
#   PUBLISH_MODE_POSITIONAL=live
#   PUBLISH_MODE_INTRADAY=live
# A per-horizon value wins over PUBLISH_MODE. Only the exact string `live` sends anything; a typo
# or an unset value is shadow, so a misconfiguration never broadcasts.
# PUBLISH_MODE_INTRADAY=
# PUBLISH_MODE_SWING=
# PUBLISH_MODE_POSITIONAL=
# Optional overrides for a self-hosted Bot API or a slow link.
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000

# Risk gate limits are NOT environment variables on purpose: they live in
# config_registry under the `risk` family (seeded as `risk-v1`), so a threshold
# change is a reviewable database row rather than a deploy.

# Optional LLM enrichment (rule engine runs regardless). OpenRouter free models work here.
HARNESS_LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Dashboard (Slice 1, Next.js in web/) ---
# Shares DATABASE_URL with the harness. Sessions live in the database, so no
# separate session secret is required.
WEB_DB_POOL=5
# Used by the bootstrap script below; not read by the running server.
OWNER_EMAIL=
OWNER_PASSWORD=
HOUSEHOLD_NAME=Home
# Create the first household login after the schema is applied:
#   npm --prefix web run create-user -- --email you@example.com
# Or set OWNER_EMAIL / OWNER_PASSWORD above and run it with no arguments.
# No local Postgres? `npm run dev:db` starts one with no admin rights (dev only).
# Local dev:  npm run web:dev    Production: docker compose up -d --build web

# --- Local-development convenience (NEVER in production) ---
# AUTH_DISABLED=true bypasses the login gate with a synthetic "dev@local" user so the dashboard
# can be explored without a session. Hard-gated on NODE_ENV !== 'production' in code: even a
# stray flag in a container environment variable cannot open a deployed instance.
AUTH_DISABLED=false
