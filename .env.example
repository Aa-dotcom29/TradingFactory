PORT=4175
NODE_ENV=development
DATA_DIR=./data
APP_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# X developer app: enable OAuth 2.0 Authorization Code with PKCE and read scopes.
# Railway callback: https://YOUR-APP.up.railway.app/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:4175/auth/x/callback

# Optional OpenAI-compatible chat completions provider for evidence-linked analysis.
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Telegram bot delivery: add the bot to your channel as an administrator.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
